# Copia este archivo como .env y rellena tus propios valores.

# Base de datos Postgres (Neon, Vercel Postgres o Supabase)
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos?sslmode=require"
DIRECT_URL="postgresql://usuario:password@host:5432/basededatos?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="genera-uno-con-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Credenciales de Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID="tu-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-client-secret"

# Emails con permisos de administrador (gestionar plantilla, calendario y
# pagos), separados por comas si hay más de uno.
ADMIN_EMAILS="tuemail@gmail.com"

# Envío de avisos por email (Gmail SMTP) a los admins, p.ej. cuando entra un
# jugador nuevo por primera vez. Opcional: si se dejan vacíos, la app
# funciona igual pero no envía avisos.
# 1. Activa la verificación en dos pasos en tu cuenta de Gmail (obligatoria
#    para poder generar contraseñas de aplicación).
# 2. Ve a https://myaccount.google.com/apppasswords, genera una para "Correo"
#    y pégala aquí (son 16 caracteres, sin espacios).
GMAIL_USER="tuemail@gmail.com"
GMAIL_APP_PASSWORD="contraseña de aplicación de 16 caracteres"
