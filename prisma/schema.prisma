// Esquema de Tarados Malibú: plantilla (activos/ayuda), calendario
// (disponibilidad, convocatorias, goles, asistencias) y pagos (inscripción,
// equipación, material) de un equipo de fútbol 7.
// Modelos de NextAuth (User, Account, Session, VerificationToken) + modelos
// propios del equipo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Posicion {
  PORTERO
  DEFENSA
  CENTROCAMPISTA
  DELANTERO
}

// ACTIVO: plantilla habitual (entra en cuotas/pagos y en el resumen de
// disponibilidad del calendario). AYUDA: jugadores puntuales a los que
// llamar si un partido va justo de gente — siguen pudiendo ser convocados,
// pero no generan pagos ni cuentan en esos resúmenes. Por defecto, un
// jugador que entra por primera vez con Google queda en AYUDA hasta que el
// admin lo mueva a ACTIVO desde /plantilla.
enum EstadoJugador {
  ACTIVO
  AYUDA
}

// Respuesta de disponibilidad de un jugador para un partido, antes de que
// el admin decida la convocatoria oficial (campo `convocado` más abajo).
enum Disponibilidad {
  SIN_RESPONDER
  VOY
  NO_VOY
  DUDA
}

// JUGADOR: cualquiera que entra con Google, por defecto (ver EstadoJugador
// para Activo/Ayuda dentro de este grupo). NO_JUGADOR: ha contestado que no
// juega (ver ElegirRolInicial) pero todavía no tiene ninguna cuota de
// socio pagada. SOCIO: ya paga la cuota de socio — se llega aquí
// automáticamente al marcarle un pago de socio como pagado (ver
// app/api/pagos/route.ts), no autoeligiéndolo. Ninguno de los dos aparece
// en plantilla como Activo/Ayuda, responde disponibilidad, ni sale en
// estadísticas; ambos tienen la misma cuota en Pagos
// (`SeccionPago.destinatario`). El admin puede corregir el rol de
// cualquiera a mano desde /plantilla en cualquier momento.
enum Rol {
  JUGADOR
  SOCIO
  NO_JUGADOR
}

model User {
  id            String    @id @default(cuid())
  name          String?
  // Solo se rellena vía login con Google. Los jugadores creados a mano por
  // el admin (ver /plantilla, "Añadir jugador") no tienen email ni cuenta:
  // son solo un registro para convocar/estadísticas, no pueden entrar en la
  // app. Varios jugadores manuales pueden tener email null a la vez (NULL
  // no choca con @unique en Postgres).
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  // Nombre elegido por el propio jugador en Ajustes, que sustituye a su
  // nombre de Google en el resto de la app (plantilla, convocatorias,
  // estadísticas, pagos...). Para jugadores manuales, que no pueden entrar
  // a poner el suyo, lo puede rellenar el admin desde /plantilla.
  apodo               String?
  dorsal              Int?
  posicion            Posicion?
  telefono            String?
  // Dónde recibir los avisos por email (p.ej. el aviso a los admins de que
  // alguien nuevo se ha registrado), si es distinto del email de login. Si
  // está vacío se usa `email`.
  emailNotificaciones String?
  // Para la inscripción/seguro del equipo. Solo los ve y edita el propio
  // jugador desde Ajustes — no se muestran en plantilla ni en ningún otro
  // sitio de la app.
  dni                 String?
  fechaNacimiento     DateTime?
  estado              EstadoJugador @default(AYUDA)
  // Ver enum Rol. Solo tiene sentido `estado`/`dorsal`/`posicion` cuando
  // rol = JUGADOR; para SOCIO/NO_JUGADOR esos campos se ignoran en toda la app.
  rol                 Rol           @default(JUGADOR)
  // Si el propio usuario ya ha contestado "¿eres jugador?" en Ajustes (ver
  // ElegirRolInicial), o si el admin ya lo ha clasificado a
  // mano desde Plantilla — en ambos casos no hace falta volver a
  // preguntárselo. Los usuarios que ya existían antes de este campo se
  // marcaron como respondido con un script aparte al desplegarlo, para no
  // preguntárselo de golpe a toda la plantilla ya clasificada.
  rolElegido          Boolean       @default(false)
  fechaAlta           DateTime      @default(now())

  accounts       Account[]
  sessions       Session[]
  convocatorias  Convocatoria[]
  pagos          Pago[]
  mensajesForo   MensajeForo[]
  lecturasForo   LecturaForo[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Un partido del calendario (liga, copa o amistoso). El resultado y los
// goles/asistencias por jugador se rellenan a toro pasado, normalmente
// justo después del partido.
model Partido {
  id                String   @id @default(cuid())
  fecha             DateTime
  rival             String
  esLocal           Boolean  @default(true)
  competicion       String   @default("Liga") // texto libre: "Liga", "Copa", "Amistoso"...
  // Solo tiene sentido cuando competicion = "Liga" (se pide/edita solo en
  // ese caso). El calendario sigue ordenando por `fecha`, no por jornada:
  // un aplazamiento puede hacer que la jornada 2 se juegue antes que la 1.
  jornada           Int?
  lugar             String?
  golesFavor        Int?
  golesContra       Int?
  // Goles que nos marca el rival en su propia puerta — no van a la cuenta
  // de ningún jugador nuestro, pero sí suman a golesFavor. Se resta aparte
  // al comprobar que los goles de la convocatoria cuadran con el resultado
  // (ver /api/partidos/[id]).
  golesPropiaPuerta Int      @default(0)
  notas             String?
  // El admin lo marca a mano una vez ha terminado de meter goles,
  // asistencias y tarjetas de este partido. Hasta entonces, aunque ya haya
  // datos cargados, no cuentan en /estadisticas (ver lib/estadisticas.ts) —
  // así nadie ve números a medio meter mientras el admin sigue editando.
  cerrado           Boolean  @default(false)
  createdAt         DateTime @default(now())

  convocatorias Convocatoria[]

  @@map("partidos")
}

// Fila por (partido, jugador): la disponibilidad que ha respondido el propio
// jugador (voy/no voy/duda, antes del partido) y la convocatoria/resultado
// (normalmente después). Una sola fila para las dos cosas porque van del
// mismo (partido, jugador). También sirve de base de las estadísticas (se
// suman todas las filas de un jugador para su ranking en /estadisticas).
model Convocatoria {
  id              String         @id @default(cuid())
  partidoId       String
  userId          String
  disponibilidad  Disponibilidad @default(SIN_RESPONDER)
  // Responder "Voy" marca esto a true automáticamente (y "No voy" lo
  // desmarca) — ver /api/partidos/[id]/disponibilidad. El admin lo puede
  // corregir a mano en cualquier momento desde el editor de convocatoria.
  convocado       Boolean        @default(false)
  goles           Int            @default(0)
  asistencias     Int            @default(0)
  tarjetaAmarilla Boolean        @default(false)
  tarjetaRoja     Boolean        @default(false)
  // Goles que encaja el equipo mientras este jugador está de portero.
  // Asignable a cualquier convocado (no solo a quien tenga posicion =
  // PORTERO): si un día no hay portero de plantilla, otro jugador puede
  // hacer ese puesto y hay que poder anotárselo igual.
  golesEncajados  Int            @default(0)

  partido Partido @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([partidoId, userId])
  @@map("convocatorias")
}

// Sección de pago del equipo (antes tres fijas — Inscripción/Equipación/
// Material —, ahora el admin puede añadir las que quiera desde /pagos).
// `orden` decide en qué orden se muestran. `destinatario` separa las
// cuotas de jugador de las cuotas de socio: cada sección es para uno de
// los dos grupos, nunca para ambos.
model SeccionPago {
  id            String   @id @default(cuid())
  nombre        String
  importe       Float    @default(0)
  orden         Int      @default(0)
  destinatario  Rol      @default(JUGADOR)
  createdAt     DateTime @default(now())

  pagos Pago[]

  @@map("secciones_pago")
}

// Una fila por (jugador, sección de pago): si lo tiene pagado o no. Se crea
// (upsert) la primera vez que el admin toca el estado de ese jugador en esa
// sección desde /pagos — no hace falta "generar" nada de antemano.
model Pago {
  id        String    @id @default(cuid())
  userId    String
  seccionId String
  importe   Float
  pagado    Boolean   @default(false)
  fechaPago DateTime?
  createdAt DateTime  @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  seccion SeccionPago @relation(fields: [seccionId], references: [id], onDelete: Cascade)

  @@unique([userId, seccionId])
  @@map("pagos")
}

// Fila única (id fijo "actual", se actualiza con upsert) con el anuncio que
// el admin quiere fijar arriba de la home. Sin historial: al cambiarlo se
// pierde el anterior, como se pidió.
model Anuncio {
  id        String   @id @default("actual")
  texto     String   @default("")
  activo    Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("anuncios")
}

// Foro tipo comentarios: temas (padreId null) y respuestas planas (un solo
// nivel, sin sub-hilos). Puede participar (abrir un tema o responder)
// cualquier jugador (activo o ayuda) y cualquier socio al día de su cuota
// (ver lib/foro.ts: puedeEscribirForo) — el resto solo puede leerlo.
model MensajeForo {
  id        String   @id @default(cuid())
  autorId   String
  // Solo los temas (padreId null) tienen título; una respuesta no.
  titulo    String?
  texto     String
  padreId   String?
  createdAt DateTime @default(now())

  autor      User          @relation(fields: [autorId], references: [id], onDelete: Cascade)
  padre      MensajeForo?  @relation("Respuestas", fields: [padreId], references: [id], onDelete: Cascade)
  respuestas MensajeForo[] @relation("Respuestas")
  lecturas   LecturaForo[]

  @@map("mensajes_foro")
}

// Cuándo vio cada usuario por última vez un tema del foro (al entrar en su
// página) — de ahí se calcula qué temas/mensajes son "nuevos" para él, tanto
// en la lista de /foro (actividad más reciente que su última visita) como
// dentro del propio tema (respuestas posteriores a esa visita). Una fila por
// (usuario, tema); solo existe para temas (padreId null), nunca para una
// respuesta suelta.
model LecturaForo {
  id      String   @id @default(cuid())
  userId  String
  temaId  String
  leidoEn DateTime @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tema MensajeForo @relation(fields: [temaId], references: [id], onDelete: Cascade)

  @@unique([userId, temaId])
  @@map("lecturas_foro")
}
